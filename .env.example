# ==============================================================================
# OpenClaw Video Subtitle Translation & Dubbing Skill — .env.example
# ==============================================================================
#
# Copy this file to `.env` and fill in your credentials to run local scripts or tests:
#   cp .env.example .env
#
# WARNING: Never commit your real `.env` file containing secrets to GitHub!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Translation Provider Settings
# ------------------------------------------------------------------------------

# Translation provider type: 'llm' (for Large Language Models) or 'web' (for web translation APIs)
TRANSLATION_PROVIDER=llm

# HTTP Endpoint for translation. Examples for OpenAI-compatible endpoints:
# - DeepSeek: https://api.deepseek.com/v1/chat/completions
# - OpenAI: https://api.openai.com/v1/chat/completions
TRANSLATION_ENDPOINT=https://api.deepseek.com/v1/chat/completions

# API Key for translation service
TRANSLATION_CREDENTIAL=your_translation_api_key_here

# LLM model name to use
TRANSLATION_MODEL_NAME=deepseek-chat


# ------------------------------------------------------------------------------
# 2. TTS (Text-to-Speech) Provider Settings
# ------------------------------------------------------------------------------

# TTS provider type: 'llm' (LLM-based TTS) or 'web' (Web TTS services such as Edge-TTS)
# 注：若仅使用 subtitle_only 模式，此处可留空
TTS_PROVIDER=web

# HTTP Endpoint for TTS service. (e.g. your custom OpenAI-compatible TTS bridge)
TTS_ENDPOINT=https://api.example.com/v1/audio/speech

# API Key for TTS service (if required)
TTS_CREDENTIAL=your_tts_api_key_here

# Default Voice ID / character model for TTS
TTS_VOICE_ID=zh-CN-XiaoxiaoNeural
